# zoho-create-invoice-automation — Environment Config
# Copy this file to .env and fill in your values

# --- Folder Paths ---
INPUT_FOLDER=C:/path/to/delivery-receipts/
OUTPUT_FOLDER=C:/path/to/generated-invoices/

# --- Database ---
DB_PATH=C:/path/to/zoho-invoice-automation/invoices.db

# --- Zoho Books REST API (OAuth2) ---
# Get Client ID + Secret from api-console.zoho.com → Self Client
# Generate REFRESH_TOKEN once via: python tools/generate_refresh_token.py <grant_code>
ZOHO_CLIENT_ID=your-client-id
ZOHO_CLIENT_SECRET=your-client-secret
ZOHO_REFRESH_TOKEN=your-refresh-token
ZOHO_ORG_ID=your-organization-id
ZOHO_REGION=com

# --- Invoice Defaults ---
DEFAULT_ITEM_RATE=1.00
DEFAULT_CUSTOMER_NAME=Generic
